# NEAR Protocol Configuration (Testnet only per hackathon guidelines)
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEXT_PUBLIC_NEAR_NODE_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_ARCHIVAL_URL=https://archival-rpc.testnet.near.org

# Database Configuration (SQLite via Drizzle for zero-setup reproducibility)
DATABASE_URL=sqlite.db

# NEAR AI Cloud (Optional - Private inference & TEE attestation)
# Obtain from https://cloud.near.ai
NEAR_AI_API_KEY=

# OutLayer API (Optional - Verifiable compute & agent custody)
# Obtain from https://app.outlayer.ai
OUTLAYER_API_KEY=
OUTLAYER_API_URL=https://app.outlayer.ai/api

# Agent Shield Gateway & Worker Secrets
AGENT_SHIELD_GATEWAY_SECRET=sample_gateway_secret_key_for_testnet_agents
AGENT_SHIELD_GATEWAY_PORT=4000
PORT=3000
